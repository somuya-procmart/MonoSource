{
  "name": "monosource",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm -w apps/api run build",
    "start": "npm -w apps/api run start",
    "db:migrate": "npm -w apps/api run migrate",
    "api": "npm -w apps/api run start:dev",
    "web": "npm -w apps/web run dev",
    "test": "npm -w apps/api test"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.2"
}
